{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "allowJs": true
  },
  "include": ["**/*.ts", "**/*.js", "src/types/**/*.d.ts", "vitest.config.mts"],
  "exclude": ["node_modules", "dist", "tests"]
}
